# Agente de edição (Claude). Sem a chave, o chat fica desativado; a edição manual segue funcionando.
ANTHROPIC_API_KEY=
# Nome alternativo, lido quando ANTHROPIC_API_KEY não está definida (útil onde esse nome é reservado).
VIDEOEDITOR_ANTHROPIC_KEY=
# Modelo do agente. Padrão: claude-sonnet-5-5. Use claude-haiku-5-5 para reduzir custo em comandos simples.
AGENT_MODEL=

# Transcrição com timestamps por palavra (Groq Whisper). Sem a chave, legendas e cortes por fala ficam indisponíveis.
GROQ_API_KEY=

# Contas e painel de administração
# E-mails (separados por vírgula) que viram admin ao se cadastrar/entrar. Em produção é a ÚNICA forma de criar admin;
# em desenvolvimento, sem esta variável, a primeira conta criada vira admin.
ADMIN_EMAILS=
# Segredo para cifrar as chaves de API salvas pelo painel. Sem ele, uma chave é gerada em .data/secret.key.
APP_SECRET=
# Pasta do banco SQLite. Padrão: apps/web/.data
DATA_DIR=
