# Agente de edição (Claude). Sem a chave, o chat fica desativado; a edição manual segue funcionando.
ANTHROPIC_API_KEY=
# Nome alternativo, lido quando ANTHROPIC_API_KEY não está definida (útil onde esse nome é reservado).
VIDEOEDITOR_ANTHROPIC_KEY=
# Modelo do agente. Padrão: claude-sonnet-5-5. Use claude-haiku-5-5 para reduzir custo em comandos simples.
AGENT_MODEL=

# Transcrição com timestamps por palavra (Groq Whisper). Sem a chave, legendas e cortes por fala ficam indisponíveis.
GROQ_API_KEY=

# Contas e painel de administração
# E-mails (separados por vírgula) que viram admin ao se cadastrar/entrar. Em produção é a ÚNICA forma de criar admin;
# em desenvolvimento, sem esta variável, a primeira conta criada vira admin.
ADMIN_EMAILS=
# Segredo para cifrar as chaves de API salvas pelo painel. Obrigatório em produção;
# em desenvolvimento, sem ele, uma chave é gerada em .data/secret.key.
APP_SECRET=

# Banco de dados (Postgres). O padrão abaixo é o do docker-compose.yml na raiz.
# Em serverless, use a URL do pooler do provedor (PgBouncer) e um DATABASE_POOL_MAX baixo.
DATABASE_URL=postgres://videoeditor:videoeditor@localhost:5432/videoeditor
# Máximo de conexões por instância da aplicação. Padrão: 10
DATABASE_POOL_MAX=

# Endereço público (sem barra no fim), usado nos links de e-mail e nos retornos do Stripe.
# Obrigatório em produção; em desenvolvimento usa o endereço da própria requisição.
APP_URL=

# E-mails transacionais (recuperação de senha) pela API do Resend.
# Sem a chave, em desenvolvimento o e-mail é impresso no terminal do servidor.
RESEND_API_KEY=
# Remetente em um domínio verificado no Resend. Ex.: videoeditor <nao-responda@seudominio.com>
EMAIL_FROM=

# Cobrança (Stripe). Também podem ser cadastradas no painel /admin (têm prioridade sobre o ambiente).
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook que aponta para {APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Ids dos preços criados no Stripe: dois recorrentes mensais (planos) e um avulso (pacote de 500 créditos).
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TOPUP=
